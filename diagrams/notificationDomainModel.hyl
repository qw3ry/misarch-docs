classDiagram {
    class("Notification") {
        public {
            title : string
            body : string
            isRead : boolean
            dateSent : DateTime
            dateRead : "DateTime?"
        }
    } layout {
        pos = apos(-730, 814)
    }

    class("User") {
    } layout {
        pos = apos(-240, 830)
    } styles {
        class += "imported"
    }

    User --> Notification with {
        label("0..* : notifications", 0.625, -34.8)
        label("1 : user", 0.216, 17.6)
        over = start(0.575).line(end(0.005))
    }

    styles {
        cls("imported") {
            type("rect") {
                strokeDash = 5
            }
        }
    }
}