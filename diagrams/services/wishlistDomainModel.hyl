classDiagram {
    class("Wishlist") {
        public {
            name : string
            createdAt : DateTime
            lastUpdatedAt : DateTime
        }
    } layout {
        pos = apos(280, -220)
    }

    class("User") layout {
        pos = rpos(Wishlist, 0.5, -196)
    } styles {
        class += "imported"
    }

    class("ProductVariant") layout {
        pos = rpos(Wishlist, 0.5, 196)
    } styles {
        class += "imported"
    }

    User --> Wishlist with {
        label("0..* : wishlists", 0.807, -67.9)
        label("1 : user", 0.053, -44.8)
        over = start(0.25).line(end(0.75))
    }

    Wishlist --> ProductVariant with {
        label("0..* : productVariants", 0.758, -94)
        label("0..* : inWishlists", 0.141, -75.3, 0)
        over = start(0.25).line(end(0.75))
    }

    styles {
        cls("imported") {
            type("rect") {
                strokeDash = 5
            }
            type("path") {
                strokeDash = 5
            }
        }
    }

}