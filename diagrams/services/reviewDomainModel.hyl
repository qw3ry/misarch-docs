classDiagram {

    class("Review") {
        public {
            body : string
            rating : int
            date : DateTime
            isHidden : boolean
        }
    } layout {
        pos = apos(810, -320)
    }

    class("User") layout {
        pos = rpos(Review, -450, 0)
    } styles {
        class += "imported"
    }

    class("Product") layout {
        pos = rpos(Review, 0, 187.5)
    } styles {
        class += "imported"
    }

    class("ProductVariant") layout {
        pos = rpos(Product, 0, 155)
    } styles {
        class += "imported"
    }

    ProductVariant --> Review with {
        label("0..* : reviews", 0.94, -35.8)
        label("1 : orderedProductVariant", 0.111, -16.4)
        over = start(0).axisAligned(1, rpos(ProductVariant, 300, -197.5), 0, end(0))
    }

    Product !--> Review with {
        label("0..* : reviews", 0.851, 67.3)
        label("1", 0.27, 26.6)
        over = start(0.75).line(end(0.25))
    }

    User --> Review with {
        label("0..* : reviews", 0.629, -16.4)
        label("1 : user", 0.269, 35.8)
        over = start(Position.Right).line(end(Position.Left))
    }

    Product --> ProductVariant with {
        label("1..* : variants", 0.767, -62)
        label("1 : product", 0.096, -53.4)
        over = start(Position.Bottom).line(end(Position.Top))
    }

    styles {
        cls("imported") {
            type("rect") {
                strokeDash = 5
            }
            type("path") {
                strokeDash = 5
            }
        }
    }
}