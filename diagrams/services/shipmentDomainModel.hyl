classDiagram {
    enum = {
        (name, fields) = args
        noedit {
            class(name, keywords = list("enumeration")) {
                sections += fields.map { "+" + it }
            }
        }
    }

    enum(
        "ShipmentStatus",
        list(
            "PENDING",
            "IN_PROGRESS",
            "DELIVERED",
            "FAILED"
        )
    ) layout {
        pos = apos(107.5, 1234.5)
    }

    class("ShipmentMethod") {
        public {
            name : string
            description : string
            baseFees : int
            feesPerItem : int
            feesPerKg : int
            archivedAt : "DateTime?"
            isArchived : boolean
        }
    } layout {
        pos = apos(1507.5, 1412.5)
    }

    class("Shipment") {
        public {
            status : ShipmentStatus
        }
    } layout {
        pos = apos(810, 1460)
    }

    class("OrderItem") layout {
        pos = apos(810, 1302)
    } styles {
        class += "imported"
    }

    class("Address", abstract = true) {
        public {
            street1 : string
            street2 : string
            city : string
            postalCode : string
            country : string
            companyName : string
        }
    } layout {
        pos = apos(107.5, 1460)
    } styles {
        class += "imported"
    }

    class("ProductVariantVersion") layout {
        pos = apos(810, 1182.5)
    } styles {
        class += "imported"
    }

    class("Order") layout {
        pos = apos(459, 1302)
    } styles {
        class += "imported"
    }

    class("Return") layout {
        pos = apos(1157, 1302)
    } styles {
        class += "imported"
    }

    Shipment !--> ShipmentMethod with {
        label("1 : shipmentMethod", 0.764, -24.7)
        label("0..*", 0.101, -23.5)
        over = start(0).line(end(0.435))
    }

    Shipment !--> Address with {
        label("1 : shipmentAddress", 0.756, 23.3)
        label("0..*", 0.117, 23.3)
        over = start(0.5).line(end(0))
    }

    Shipment !--> OrderItem with {
        label("0..* : sentItems", 0.854, -66)
        label("1..*", 0.314, -24.5)
        over = start(0.695).line(end(0.305))
    }

    Order --> Shipment with {
        label("1..* : shipments", 0.559, -20.4)
        label("0..1 : order", 0.097, -48.2)
        over = start(0.235).axisAligned(-0.5, end(0.655))
    }

    Return --> Shipment with {
        label("1 : shipment", 0.437, -38.9)
        label("0..1 : return", 0.574, 20.4)
        over = start(0.2575).axisAligned(-0.5, end(0.86125))
    }

    Shipment <--! OrderItem with {
        label("1 : sentWith", 0.314, 60.1)
        label("0..1", 0.94, -30.1)
        over = start(0.835).line(end(0.165))
    }

    OrderItem !--> ProductVariantVersion with {
        label("1 : productVariantVersion", 0.805, 110.5, 0)
        label("0..*", 0.355, 32.2)
        over = start(Position.Top).line(end(Position.Bottom))
    }

    styles {
        cls("imported") {
            type("rect") {
                strokeDash = 5
            }
            type("path") {
                strokeDash = 5
            }
        }
    }

}