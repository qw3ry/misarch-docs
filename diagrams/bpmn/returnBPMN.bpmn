<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Return_Reconstructed" targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:message id="Message_request" name="Return Request"/>
    <bpmn:message id="Message_confirmation" name="Return Confirmation"/>
    <bpmn:message id="Message_cancellation" name="Return Cancellation"/>
    <bpmn:message id="Message_completion" name="Return Completion"/>
    <bpmn:message id="Message_shipment" name="Product Shipment"/>
    <bpmn:collaboration id="Collaboration_Return">
        <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>
        <bpmn:participant id="Participant_Shop" name="Shop" processRef="Process_Shop"/>
        <bpmn:messageFlow id="MF_Request" sourceRef="C_SendRequest" targetRef="S_Start"/>
        <bpmn:messageFlow id="MF_Confirmation" sourceRef="S_ConfirmReturn" targetRef="C_Confirmation"/>
        <bpmn:messageFlow id="MF_Completion" sourceRef="S_SendCompletion" targetRef="C_Completed"/>
        <bpmn:messageFlow id="MF_Cancellation" sourceRef="S_SendCancellation" targetRef="C_Cancelled"/>
    </bpmn:collaboration>
    <bpmn:process id="Process_Customer" isExecutable="false">
        <bpmn:startEvent id="C_Start" name="Wants to return product"/>
        <bpmn:task id="C_ChooseOrder" name="Choose Order"/>
        <bpmn:task id="C_ChooseProducts" name="Choose Products"/>
        <bpmn:task id="C_CreateRequest" name="Create Return Request"/>
        <bpmn:intermediateThrowEvent id="C_SendRequest" name="Send Return Request">
            <bpmn:messageEventDefinition messageRef="Message_request"/>
        </bpmn:intermediateThrowEvent>
        <bpmn:exclusiveGateway id="C_ResponseGateway"/>
        <bpmn:intermediateCatchEvent id="C_Confirmation" name="Return Confirmation">
            <bpmn:messageEventDefinition messageRef="Message_confirmation"/>
        </bpmn:intermediateCatchEvent>
        <bpmn:task id="C_PrintLabel" name="Print Shipping Label"/>
        <bpmn:intermediateThrowEvent id="C_ShipProduct" name="Ship Product">
            <bpmn:messageEventDefinition messageRef="Message_shipment"/>
        </bpmn:intermediateThrowEvent>
        <bpmn:intermediateCatchEvent id="C_Completed" name="Return completed">
            <bpmn:messageEventDefinition messageRef="Message_completion"/>
        </bpmn:intermediateCatchEvent>
        <bpmn:task id="C_ReceiveRefund" name="Receive Refund"/>
        <bpmn:endEvent id="C_EndSuccess"/>
        <bpmn:intermediateCatchEvent id="C_Cancelled" name="Cancel Confirmation">
            <bpmn:messageEventDefinition messageRef="Message_cancellation"/>
        </bpmn:intermediateCatchEvent>
        <bpmn:endEvent id="C_EndCancelled"/>
        <bpmn:sequenceFlow id="C_F1" sourceRef="C_Start" targetRef="C_ChooseOrder"/>
        <bpmn:sequenceFlow id="C_F2" sourceRef="C_ChooseOrder" targetRef="C_ChooseProducts"/>
        <bpmn:sequenceFlow id="C_F3" sourceRef="C_ChooseProducts" targetRef="C_CreateRequest"/>
        <bpmn:sequenceFlow id="C_F4" sourceRef="C_CreateRequest" targetRef="C_SendRequest"/>
        <bpmn:sequenceFlow id="C_F5" sourceRef="C_SendRequest" targetRef="C_ResponseGateway"/>
        <bpmn:sequenceFlow id="C_F6" sourceRef="C_ResponseGateway" targetRef="C_Confirmation"/>
        <bpmn:sequenceFlow id="C_F7" sourceRef="C_ResponseGateway" targetRef="C_Cancelled"/>
        <bpmn:sequenceFlow id="C_F8" sourceRef="C_Confirmation" targetRef="C_PrintLabel"/>
        <bpmn:sequenceFlow id="C_F9" sourceRef="C_PrintLabel" targetRef="C_ShipProduct"/>
        <bpmn:sequenceFlow id="C_F10" sourceRef="C_ShipProduct" targetRef="C_Completed"/>
        <bpmn:sequenceFlow id="C_F11" sourceRef="C_Completed" targetRef="C_ReceiveRefund"/>
        <bpmn:sequenceFlow id="C_F12" sourceRef="C_ReceiveRefund" targetRef="C_EndSuccess"/>
        <bpmn:sequenceFlow id="C_F13" sourceRef="C_Cancelled" targetRef="C_EndCancelled"/>
    </bpmn:process>
    <bpmn:process id="Process_Shop" isExecutable="false">
        <bpmn:startEvent id="S_Start" name="Return Request Received">
            <bpmn:messageEventDefinition messageRef="Message_request"/>
        </bpmn:startEvent>
        <bpmn:task id="S_CheckRequest" name="Check Return Request"/>
        <bpmn:exclusiveGateway id="S_RequestValid" name="Request Valid?"/>
        <bpmn:intermediateThrowEvent id="S_ConfirmReturn" name="Confirm Return">
            <bpmn:messageEventDefinition messageRef="Message_confirmation"/>
        </bpmn:intermediateThrowEvent>
        <bpmn:exclusiveGateway id="S_WaitResult"/>
        <bpmn:intermediateCatchEvent id="S_ProductReceived" name="Product received">
            <bpmn:messageEventDefinition messageRef="Message_shipment"/>
        </bpmn:intermediateCatchEvent>
        <bpmn:intermediateCatchEvent id="S_TimeLimit" name="Return time limit passed">
            <bpmn:timerEventDefinition/>
        </bpmn:intermediateCatchEvent>
        <bpmn:task id="S_ThrowAway" name="Throw away Received Products"/>
        <bpmn:intermediateThrowEvent id="S_SendCancellation" name="Send Cancellation">
            <bpmn:messageEventDefinition messageRef="Message_cancellation"/>
        </bpmn:intermediateThrowEvent>
        <bpmn:endEvent id="S_EndCancelled"/>
        <bpmn:task id="S_Refund" name="Refund Payment"/>
        <bpmn:boundaryEvent id="S_RefundError" attachedToRef="S_Refund">
            <bpmn:errorEventDefinition/>
        </bpmn:boundaryEvent>
        <bpmn:task id="S_NotifyRefundFailure" name="Notify User about Failed Refund"/>
        <bpmn:endEvent id="S_EndRefundFailure"/>
        <bpmn:task id="S_CreateConfirmation" name="Create Confirmation">
            <bpmn:dataInputAssociation id="S_ConfirmationInput">
                <bpmn:sourceRef>S_ConfirmationObject</bpmn:sourceRef>
            </bpmn:dataInputAssociation>
        </bpmn:task>
        <bpmn:intermediateThrowEvent id="S_SendCompletion" name="Send Completion">
            <bpmn:messageEventDefinition messageRef="Message_completion"/>
        </bpmn:intermediateThrowEvent>
        <bpmn:endEvent id="S_EndCompleted"/>
        <bpmn:dataObject id="Data_ReturnConfirmation"/>
        <bpmn:dataObjectReference id="S_ConfirmationObject" name="Return Confirmation"
                                  dataObjectRef="Data_ReturnConfirmation"/>
        <bpmn:sequenceFlow id="S_F1" sourceRef="S_Start" targetRef="S_CheckRequest"/>
        <bpmn:sequenceFlow id="S_F2" sourceRef="S_CheckRequest" targetRef="S_RequestValid"/>
        <bpmn:sequenceFlow id="S_F3" sourceRef="S_RequestValid" targetRef="S_ConfirmReturn"/>
        <bpmn:sequenceFlow id="S_F4" sourceRef="S_RequestValid" targetRef="S_SendCancellation" name="No"/>
        <bpmn:sequenceFlow id="S_F5" sourceRef="S_ConfirmReturn" targetRef="S_WaitResult"/>
        <bpmn:sequenceFlow id="S_F6" sourceRef="S_WaitResult" targetRef="S_ProductReceived"/>
        <bpmn:sequenceFlow id="S_F7" sourceRef="S_WaitResult" targetRef="S_TimeLimit"/>
        <bpmn:sequenceFlow id="S_F8" sourceRef="S_ProductReceived" targetRef="S_ThrowAway"/>
        <bpmn:sequenceFlow id="S_F9" sourceRef="S_TimeLimit" targetRef="S_SendCancellation"/>
        <bpmn:sequenceFlow id="S_F10" sourceRef="S_SendCancellation" targetRef="S_EndCancelled"/>
        <bpmn:sequenceFlow id="S_F11" sourceRef="S_ThrowAway" targetRef="S_Refund"/>
        <bpmn:sequenceFlow id="S_F12" sourceRef="S_Refund" targetRef="S_CreateConfirmation"/>
        <bpmn:sequenceFlow id="S_F13" sourceRef="S_CreateConfirmation" targetRef="S_SendCompletion"/>
        <bpmn:sequenceFlow id="S_F14" sourceRef="S_SendCompletion" targetRef="S_EndCompleted"/>
        <bpmn:sequenceFlow id="S_E1" sourceRef="S_RefundError" targetRef="S_NotifyRefundFailure"/>
        <bpmn:sequenceFlow id="S_E2" sourceRef="S_NotifyRefundFailure" targetRef="S_EndRefundFailure"/>
    </bpmn:process>
    <bpmndi:BPMNDiagram id="Diagram_Return">
        <bpmndi:BPMNPlane id="Plane_Return" bpmnElement="Collaboration_Return">
            <bpmndi:BPMNShape id="Participant_Customer_di" bpmnElement="Participant_Customer" isHorizontal="true">
                <dc:Bounds x="160" y="40" width="1658" height="313"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Participant_Shop_di" bpmnElement="Participant_Shop" isHorizontal="true">
                <dc:Bounds x="160" y="420" width="1658" height="438"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="C_Start_di" bpmnElement="C_Start">
